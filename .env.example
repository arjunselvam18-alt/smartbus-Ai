# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_SHEETS_API_URL: The Google Apps Script Web App deployment URL for database persistence.
# Can also be entered dynamically in the app's Settings page.
GOOGLE_SHEETS_API_URL="https://script.google.com/macros/s/.../exec"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps JavaScript API key for live transit tracking.
# Can also be configured directly in the Settings page or via environment variables.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# GOOGLE_ROUTES_API_KEY: Dedicated server-side API key for Google Routes API (directions/v2:computeRoutes).
# Stored securely server-side and never exposed to the client or browser.
GOOGLE_ROUTES_API_KEY="YOUR_GOOGLE_ROUTES_API_KEY"

# Optional server-side initial Admin bootstrap credentials (never commit real secrets).
# If omitted, complete the one-time Initial Admin Setup inside the Admin Dashboard UI.
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="SET_STRONG_ADMIN_PASSWORD"
# Optional token required during one-time browser-based initial Admin setup if set:
# ADMIN_SETUP_TOKEN="SET_ONE_TIME_SETUP_TOKEN"

# SMARTBUS_AUTH_SECRET: Persistent HMAC secret for Admin & Staff session tokens (required on Vercel serverless).
SMARTBUS_AUTH_SECRET="CHANGE_TO_LONG_RANDOM_64_CHAR_HEX_SECRET"

